{
  "model": "claude-sonnet-5-5",
  "env": {
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_RETRY_WATCHDOG": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(curl http://localhost:3000*)",
      "Bash(git switch *)"
    ]
  }
}
